# Copy to .env and fill in real values. Never commit the real .env.
# Place this file at the project root (config.py loads it via load_dotenv).

# Long random string used to sign sessions and CSRF tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-string

# Database URL. Default is a local SQLite file under sol_main/instance/.
DATABASE_URL=sqlite:///solomon.db
